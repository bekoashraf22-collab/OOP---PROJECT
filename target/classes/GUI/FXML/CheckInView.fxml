<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="GUI.Controllers.CheckInController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="header">
            <Button text="← Dashboard" onAction="#back" styleClass="ghost-button"/>
            <Label text="✅ Check-in Guest" styleClass="title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Logout" onAction="#logout" styleClass="danger-button"/>
        </HBox>
    </top>
    <center>
        <HBox spacing="22" styleClass="content">
            <VBox spacing="14" styleClass="card" prefWidth="520">
                <Label text="Check-in Form" styleClass="nav-title"/>
                <Label text="Guest" styleClass="input-label"/>
                <ComboBox fx:id="guestBox" maxWidth="Infinity"/>
                <Label text="Available Room" styleClass="input-label"/>
                <ComboBox fx:id="roomBox" maxWidth="Infinity"/>
                <Label text="Guests staying" styleClass="input-label"/>
                <TextField fx:id="guestCountField" promptText="Example: 2"/>
                <Label text="Check-out Date" styleClass="input-label"/>
                <DatePicker fx:id="checkoutPicker" maxWidth="Infinity"/>
                <Button fx:id="checkInButton" text="Check In Guest" onAction="#checkIn" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="14" styleClass="hero" HBox.hgrow="ALWAYS">
                <Label text="Front Desk Preview" styleClass="title"/>
                <Label fx:id="statusLabel" wrapText="true" styleClass="subtitle"/>
                <Label fx:id="threadLabel" text="" visible="false" managed="false"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>
