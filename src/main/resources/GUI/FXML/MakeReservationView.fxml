<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?><?import javafx.scene.control.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="GUI.Controllers.MakeReservationController">
    <top><HBox alignment="CENTER_LEFT" spacing="12" styleClass="header"><Button text="← Dashboard" onAction="#back" styleClass="ghost-button"/><Label text="➕ Make Reservation" styleClass="title"/><Region HBox.hgrow="ALWAYS"/><Button text="Logout" onAction="#logout" styleClass="danger-button"/></HBox></top>
    <center><HBox spacing="22" styleClass="content">
        <VBox spacing="14" styleClass="card" prefWidth="480">
            <Label text="Booking Details" styleClass="nav-title"/>
            <Label text="Choose Room" styleClass="input-label"/><ComboBox fx:id="roomBox" maxWidth="Infinity"/>
            <Label text="How Many Guests?" styleClass="input-label"/><TextField fx:id="guestCountField" promptText="Number of people staying"/>
            <Label text="Check-out Date" styleClass="input-label"/><DatePicker fx:id="checkoutPicker" maxWidth="Infinity"/>
            <Button fx:id="reserveButton" text="Confirm Reservation" onAction="#reserve" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="12" styleClass="hero" HBox.hgrow="ALWAYS"><Label text="Live Price Preview" styleClass="title"/><Label fx:id="summaryLabel" text="Choose details." wrapText="true" styleClass="subtitle"/></VBox>
    </HBox></center>
</BorderPane>
